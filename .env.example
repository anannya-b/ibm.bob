# FinLit AI – Environment Variables
# Copy this file to .env and fill in your credentials.
# DO NOT commit the .env file to version control.

# -----------------------------------------------------------------------
# IBM watsonx.ai Credentials (required)
# -----------------------------------------------------------------------
# Get these from IBM Cloud: https://cloud.ibm.com/
# 1. Create a free IBM Cloud account (Lite plan)
# 2. Create a watsonx.ai project at https://dataplatform.cloud.ibm.com
# 3. Generate an API key at https://cloud.ibm.com/iam/apikeys

WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Service URL — change only if using a region other than US South
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# -----------------------------------------------------------------------
# Model Configuration (optional — defaults shown)
# -----------------------------------------------------------------------
# Default model: ibm/granite-13b-chat-v2
# Other available Granite models:
#   ibm/granite-7b-lab
#   ibm/granite-13b-instruct-v2
#   ibm/granite-20b-multilingual

WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
